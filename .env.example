# Format: KEY=VALUE, one per line. Read as data by the deploy scripts and the PM2 config, never run
# by a shell: no $expansion, no quotes needed (one pair of outer quotes is removed), no inline comments.
# On the server this file is root:velum 640 (/srv/velum/.env): edit it as root, then run
# `sudo bash /srv/velum/deploy/deploy.sh`. Each process gets only the keys it reads
# (deploy/ecosystem.config.cjs): the web runs as its own user and gets NEXT_PUBLIC_*, PUBLIC_SITE_URL,
# PORT_WEB and NODE_ENV from web.env, which root renders from this file on every release (the web user
# cannot read this file); DATABASE_URL/REDIS_URL reach only api and workers; a hot key reaches only the
# process that uses it. server-setup.sh starts a new server's .env from this file.
# "Phase 3+, unused" marks keys no code reads yet: they are kept so the layout stays stable.

# ───────── General ─────────
NODE_ENV=production
DOMAIN=velum.example
PUBLIC_SITE_URL=https://velum.example
# Phase 2: every trade is simulated whatever this says (the API reports demoMode: true in /v1/health and
# the web always shows the demo notices). false takes effect with the Phase 3 contracts.
DEMO_MODE=true
# testnet | mainnet. Switch with: sudo bash deploy/set-network.sh mainnet (sets every key below together).
# Mainnet is read-only in Phase 2: real wallet + balances, simulated trades, no contracts. A release runs
# only with the VELUM_NETWORK, CHAIN_ID and NEXT_PUBLIC_* values it was built with (deploy.sh --rollback
# refuses others).
VELUM_NETWORK=testnet
NEXT_PUBLIC_VELUM_NETWORK=testnet

# ───────── Web (Next.js, apps/web) ─────────
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# WalletConnect is hidden until a project ID is set (free at cloud.reown.com). Setting it also adds the
# WalletConnect/Reown hosts to the Content-Security-Policy on the next release.
PORT_WEB=3000
NEXT_PUBLIC_API_URL=https://velum.example/api
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Phase 3+, unused: the web keeps the demo notices on regardless (Phase 2 has no real write path).
NEXT_PUBLIC_DEMO_MODE=true
# Shown to wallets (WalletConnect metadata). Defaults to the page origin.
NEXT_PUBLIC_SITE_URL=https://velum.example

# ───────── API (Fastify, apps/api) ─────────
PORT_API=4000
# PORT is read only when PORT_API is unset (local tools that set PORT); leave it out on the server.
# PORT=
# Fastify listens on localhost only; Nginx proxies /api/ to it.
HOST=127.0.0.1
# On the server the API listens on this unix socket instead of HOST:PORT_API (server-setup.sh sets it):
# its directory (root-created at boot, tmpfiles.d) only the app user and Nginx can enter, so no other
# local user can take the API's address and receive PROXY_SECRET. Empty = HOST:PORT_API (local dev).
# Needs PROXY_SECRET (the API refuses to start without it: on the socket every client would share one
# rate limit).
API_SOCKET=
# fatal | error | warn | info | debug | trace | silent (anything else stops api and workers at start).
LOG_LEVEL=info
CORS_ORIGIN=https://velum.example
DATABASE_URL=postgresql://velum:CHANGE_ME@127.0.0.1:5432/velum?schema=public
# redis://:PASSWORD@127.0.0.1:6379/5 for the shared Redis (server-setup.sh writes it, REDIS_DB 5), or
# unix://:PASSWORD@/run/velum-redis/redis.sock for Velum's own Redis (deploy/redis-velum.sh writes it;
# recommended on a shared server, docs/05). URL-encode special characters in the password.
REDIS_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379
# Shared secret Nginx adds to every /api/ request (X-Velum-Proxy-Secret, root-only snippet), sent only over
# API_SOCKET. With it the API trusts X-Real-IP only from Nginx, so other programs on a shared server cannot
# spoof client addresses. server-setup.sh generates it (hex, 32-128 characters); empty = trust
# X-Forwarded-For from loopback as before (only without API_SOCKET). Changing it needs server-setup.sh
# (or a release) so Nginx and the API agree.
PROXY_SECRET=
# Per client (IPv6 per /64) and minute. /v1/markets has its own budget (the web polls every 2 s).
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_MARKETS_PER_MIN=600
RATE_LIMIT_QUOTE_PER_MIN=30
# Phase 3+, unused (no relay endpoints yet).
RATE_LIMIT_RELAY_PER_MIN=10
# Per client; each health call pings Postgres and Redis. deploy.sh polls it at most 30 times a minute,
# in its own bucket.
RATE_LIMIT_HEALTH_PER_MIN=60

# ───────── Chain ─────────
# Public RPC is rate-limited (official docs). For production use a provider URL here. Its eth_chainId
# must equal CHAIN_ID: otherwise /v1/health answers 503.
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Phase 3+, unused (no indexer yet).
INDEXER_START_BLOCK=0
CONFIRMATIONS=2

# ───────── Workers (apps/workers) ─────────
PRICE_POLL_MS=2000
# demo (simulated; refused with VELUM_NETWORK=mainnet) | robinhood (official quotes,
# api.robinhood.com/rhj/prices) | chainlink (verified feeds only)
PRICE_SOURCE=demo
# Phase 3+, unused (no funding worker yet).
FUNDING_EPOCH_SECONDS=3600
PRICE_TICK_RETENTION_DAYS=7

# ───────── Hot keys (Phase 3+, unused). One key per role, separate processes, small balances. ─────────
# Create one with: sudo bash deploy/new-key.sh PRICE_RELAY_PRIVATE_KEY (prints only the address).
# Phase 2 passes none of them to any process (the workers sign nothing yet).
RELAYER_PRIVATE_KEY=
PRICE_RELAY_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=
RISK_WORKER_A_PRIVATE_KEY=
RISK_WORKER_B_PRIVATE_KEY=
RELAYER_MIN_BALANCE_ETH=0.05
ALERT_WEBHOOK_URL=

# ───────── Local development only ─────────
# Proxy /api to Fastify from `next dev` / `next start` (Nginx does this in production).
# API_PROXY_TARGET=http://127.0.0.1:4000
# Tests only: a migrated scratch database for the Postgres-backed tests (pnpm test skips them without it).
# Never point it at a database with data you need: the tests create and delete rows.
# TEST_DATABASE_URL=postgresql://velum:velum@127.0.0.1:5432/velum_test?schema=public

# ───────── Contracts deploy only (contracts/script/Deploy.s.sol). Never on the VPS .env. ─────────
# Set these in the shell of the machine that runs `forge script`, for that command only. Testnet only:
# the script refuses mainnet (chain 4663) before the Phase 5 audit.
# DEPLOYER_KEY=            funded testnet deployer key, passed as --private-key $DEPLOYER_KEY (never commit it)
# PRICE_RELAYER=           address of the dedicated price-relay key; required on testnet, must not be the deployer
# GUARDIAN=                optional address allowed to switch markets to close-only (default: none)
# PRICE_MIN_USD=1          optional lower bound for relayed prices, whole USD (default 1)
# PRICE_MAX_USD=100000     optional upper bound for relayed prices, whole USD (default 100000)
# OI_CAP_TOKENS=10000      optional open-interest cap per side and market, whole tokens (default 10000)
# USDG_ADDRESS=            optional: override the token list from packages/config ...
# STOCK_ADDRESSES=         ... with these comma-separated stock token addresses ...
# STOCK_SYMBOLS=           ... and their symbols in the same order
