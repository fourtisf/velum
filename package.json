{
  "name": "velum",
  "private": true,
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @velum/db exec prisma migrate deploy",
    "db:generate": "pnpm --filter @velum/db exec prisma generate"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "8.57.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "msgpackr-extract",
      "bufferutil",
      "utf-8-validate",
      "keccak"
    ],
    "overrides": {
      "@walletconnect/ethereum-provider@2.21.1": "2.26.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "postcss@<8.5.23": "^8.5.23"
    }
  }
}
