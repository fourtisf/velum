# Format: KEY=VALUE, one per line. Read as data by the deploy scripts and the PM2 config, never run
# by a shell: no $expansion, no quotes needed (one pair of outer quotes is removed), no inline comments.
# On the server this file is root:velum 640 (/srv/velum/.env): edit it as root, then run
# `sudo bash /srv/velum/deploy/deploy.sh`. Each process gets only the keys it reads
# (deploy/ecosystem.config.cjs): the web runs as its own user and gets NEXT_PUBLIC_*, PUBLIC_SITE_URL,
# PORT_WEB and NODE_ENV from web.env, which root renders from this file on every release (the web user
# cannot read this file); DATABASE_URL/REDIS_URL reach only api and workers; a hot key reaches only the
# process that uses it.

# ───────── General ─────────
NODE_ENV=production
DOMAIN=velum.example
PUBLIC_SITE_URL=https://velum.example
# true = trades are simulated in the browser (Phase 2). false = real contracts (Phase 3+).
DEMO_MODE=true
# testnet | mainnet. Switch with: sudo bash deploy/set-network.sh mainnet (sets every key below together).
# Mainnet is read-only in Phase 2: real wallet + balances, simulated trades, no contracts. A release runs
# only with the VELUM_NETWORK, CHAIN_ID and NEXT_PUBLIC_* values it was built with (deploy.sh --rollback
# refuses others).
VELUM_NETWORK=testnet
NEXT_PUBLIC_VELUM_NETWORK=testnet

# ───────── Web (Next.js, apps/web) ─────────
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# WalletConnect is hidden until a project ID is set (free at cloud.reown.com). Setting it also adds the
# WalletConnect/Reown hosts to the Content-Security-Policy on the next release.
PORT_WEB=3000
NEXT_PUBLIC_API_URL=https://velum.example/api
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEMO_MODE=true
# Shown to wallets (WalletConnect metadata). Defaults to the page origin.
NEXT_PUBLIC_SITE_URL=https://velum.example

# ───────── API (Fastify, apps/api) ─────────
PORT_API=4000
# Fastify listens on localhost only; Nginx proxies /api/ to it.
HOST=127.0.0.1
# On the server the API listens on this unix socket instead of HOST:PORT_API (server-setup.sh sets it):
# its directory (root-created at boot, tmpfiles.d) only the app user and Nginx can enter, so no other
# local user can take the API's address and receive PROXY_SECRET. Empty = HOST:PORT_API (local dev).
API_SOCKET=
LOG_LEVEL=info
CORS_ORIGIN=https://velum.example
DATABASE_URL=postgresql://velum:CHANGE_ME@127.0.0.1:5432/velum?schema=public
REDIS_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379
# Shared secret Nginx adds to every /api/ request (X-Velum-Proxy-Secret, root-only snippet), sent only over
# API_SOCKET. With it the API trusts X-Real-IP only from Nginx, so other programs on a shared server cannot
# spoof client addresses. server-setup.sh generates it (hex, 32-128 characters); empty = trust
# X-Forwarded-For from loopback as before. Changing it needs server-setup.sh (or a release) so Nginx and
# the API agree.
PROXY_SECRET=
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_QUOTE_PER_MIN=30
RATE_LIMIT_RELAY_PER_MIN=10
# Per client; each health call pings Postgres and Redis. deploy.sh polls it at most 30 times a minute,
# in its own bucket.
RATE_LIMIT_HEALTH_PER_MIN=60

# ───────── Chain ─────────
# Public RPC is rate-limited (official docs). For production use a provider URL here.
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
INDEXER_START_BLOCK=0
CONFIRMATIONS=2

# ───────── Workers (apps/workers) ─────────
PRICE_POLL_MS=2000
# demo (simulated) | robinhood (official quotes, api.robinhood.com/rhj/prices) | chainlink (verified feeds only)
PRICE_SOURCE=demo
FUNDING_EPOCH_SECONDS=3600
PRICE_TICK_RETENTION_DAYS=7

# ───────── Hot keys (Phase 3+). One key per role, separate processes, small balances. ─────────
# Create one with: sudo bash deploy/new-key.sh PRICE_RELAY_PRIVATE_KEY (prints only the address).
# Phase 2 passes only PRICE_RELAY_PRIVATE_KEY, and only to velum-workers; the others reach no process yet.
RELAYER_PRIVATE_KEY=
PRICE_RELAY_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=
RISK_WORKER_A_PRIVATE_KEY=
RISK_WORKER_B_PRIVATE_KEY=
RELAYER_MIN_BALANCE_ETH=0.05
ALERT_WEBHOOK_URL=

# ───────── Local development only ─────────
# Proxy /api to Fastify from `next dev` / `next start` (Nginx does this in production).
# API_PROXY_TARGET=http://127.0.0.1:4000
